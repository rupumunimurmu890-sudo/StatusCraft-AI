{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statuscraft-ai",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "QUOTES_KV",
      "id": "28fb8c16d0fa4f13aee16b2c47bc9a93"
    }
  ]
}
